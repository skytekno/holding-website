APP_ENV=development
PORT=8080
DATABASE_URL=postgres://skyholding:sky-local-development-only@localhost:54320/skyholding
DATABASE_MAX_CONNECTIONS=5
# Production URLs require sslmode=verify-full. For a provider-specific CA,
# mount its PEM bundle read-only on both API and migration job, then set:
# PGSSLROOTCERT=/var/run/secrets/postgres/ca.pem
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Development only; never configure this in production. Matches the local dashboard login.
DEV_AUTH_TOKEN=sky-holding-local-development-token-2026-only
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=
STORAGE_BACKEND=local
LOCAL_ASSET_PATH=./var/assets
ASSETS_BASE_URL=http://localhost:8080/assets
GCS_BUCKET=
RUST_LOG=sky_holding_api=info,tower_http=info
